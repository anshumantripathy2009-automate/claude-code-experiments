# ---------------------------------------------------------------------------
# NoirFlow Automation Lab — repo-wide ignore rules
# Anything matched here must never reach git. Secrets in git history are
# permanent: removing the file later does NOT remove it from past commits.
# ---------------------------------------------------------------------------

# Environment / secrets
.env
.env.local
.env.*.local
.env.production
.env.development
# NOTE: .env.example files are intentionally tracked — they are templates
# containing placeholders only, never real values.
!.env.example

# Service account & credential files (Google Sheets, Supabase, etc.)
*service-account*.json
*credentials*.json
gcp-key*.json
*.pem
*.key
*.p12
*.pfx

# Dependencies
node_modules/

# Vercel
.vercel

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Python caches (skills/ scripts)
__pycache__/
*.pyc
