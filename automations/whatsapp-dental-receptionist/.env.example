# Google Gemini API key (free tier available)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets integration — bookings are auto-logged as rows.
# See README.md "Google Sheets setup" for how to create these.
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the service account's private key exactly as it appears in the downloaded
# JSON key file's "private_key" field (with literal \n sequences, wrapped in quotes).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Supabase — persists conversation history across serverless invocations
# (without this, the receptionist forgets the patient after every message).
# See README.md "Supabase Setup" for the table SQL and where to find these.
# Project Settings → Data API → "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → "service_role" secret key (NOT the anon/public key —
# this bypasses Row Level Security, so keep it server-side only, never in client code).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
