# Google Places API (New) key — Google Cloud Console → APIs & Services → Credentials.
# Restrict it to "Places API (New)" only. In cloud Claude Code sessions, add it as an
# environment variable in the environment settings instead of a .env file.
GOOGLE_MAPS_API_KEY=

# Safety cap: the run stops after this many API requests (each returns up to 20 places).
# Keeps you inside Google's free monthly allowance. Raise it only on purpose.
MAX_REQUESTS=40
