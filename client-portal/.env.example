# All three values come from the SAME Supabase project — the one your
# automations log into (today: "noirflow-agents"). The portal and the
# automations must share a project so bookings/errors show up for clients.

# Project Settings → Data API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API Keys → "publishable" key (sb_publishable_...).
# Safe in the browser: every table it can reach has Row Level Security that
# limits a logged-in client to their own rows, and invites/admins are
# revoked from it entirely.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# That's all. There is intentionally NO service-role key in this app:
#   - admin powers come from Row Level Security (a row in `admins`), and
#   - creating accounts from invite codes runs in the `redeem-invite`
#     Supabase Edge Function, where Supabase supplies the key itself.
