# Supabase project — reuses the same "noirflow-agents" project that backs
# your automations, so there's only one Supabase project to manage.
# Project Settings → Data API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API Keys → "publishable" key (sb_publishable_...).
# Safe to expose in the browser bundle — every table it can touch has Row
# Level Security policies scoping it to the logged-in user's own data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Project Settings → API Keys → "service_role" secret key. Server-side only —
# NEVER prefix this with NEXT_PUBLIC_, and never import it into a Client
# Component. It bypasses Row Level Security entirely; only app/dashboard/actions.js
# should ever use it, for the one privileged operation a client can't do
# themselves (linking their new login to the client row NoirFlow created
# for them during onboarding).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
