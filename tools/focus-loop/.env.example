# Google Gemini API key (free tier available)
# Get yours at https://aistudio.google.com/app/apikey
# Same key setup as automations/whatsapp-dental-receptionist/ and
# demos/riya-voice/ — the key stays server-side in api/chat.js and is
# never sent to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Debug flag — set to 1 to surface Google's real error message in the browser
# when an API call fails. OFF by default so production never leaks internal
# error details. Useful when debugging from a phone with no access to the
# Vercel function logs; turn it back off when you're done.
DEBUG_ERRORS=
